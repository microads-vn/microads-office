<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MicroadsOffice</RootNamespace>
    <AssemblyName>MicroadsOffice</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <Product>Microads Office</Product>
    <AssemblyTitle>Microads Office</AssemblyTitle>
    <Company>Công ty TNHH Công nghệ Microads (microads.vn)</Company>
    <Description>Microads Office — Word, Excel, PDF. Phát hành bởi Công ty TNHH Công nghệ Microads, luôn luôn miễn phí. microads.vn</Description>
    <Copyright>© 2026 Microads — microads.vn</Copyright>
    <Version>2.0.2</Version>
    <FileVersion>2.0.2.0</FileVersion>
    <NoWarn>CA1416;SYSLIB0057;WFO1000;WFDEV001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MicroadsOffice.Core\MicroadsOffice.Core.csproj" />
    <ProjectReference Include="..\MicroadsOffice.UI\MicroadsOffice.UI.csproj" />
    <ProjectReference Include="..\MicroadsOffice.Pdf\MicroadsOffice.Pdf.csproj" />
    <ProjectReference Include="..\MicroadsOffice.Word\MicroadsOffice.Word.csproj" />
    <ProjectReference Include="..\MicroadsOffice.Excel\MicroadsOffice.Excel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- PDFium is embedded so that Microads Office ships as ONE executable (extracted on first use). -->
    <EmbeddedResource Include="$([MSBuild]::EnsureTrailingSlash($(NuGetPackageRoot)))bblanchon.pdfium.win32\159.0.8152\runtimes\win-x64\native\pdfium.dll" LogicalName="pdfium.dll" Link="Assets\pdfium.dll" />
  </ItemGroup>
</Project>
