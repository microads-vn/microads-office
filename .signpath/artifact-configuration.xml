<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for the GitHub Actions artifact uploaded by .github/workflows/release.yml
     (a ZIP containing MicroadsOffice.exe and MicroadsOffice_Setup.exe). Paste it into SignPath › Project › Artifact configurations. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="MicroadsOffice.exe" product-name="Microads Office">
      <authenticode-sign />
    </pe-file>
    <pe-file path="MicroadsOffice_Setup.exe" product-name="Microads Office">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
